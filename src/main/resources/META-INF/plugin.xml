<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>me.cw2.Nekoama</id>
    <name>Nekoama</name>
    <vendor url="https://github.com/cw2me">cw2</vendor>
    <description><![CDATA[
        <h2>Nekoama：AI 智能代码助手插件</h2>

        <p><b>Nekoama</b>是一款强大的 IntelliJ IDEA 插件，集成先进的大语言模型技术，为开发者提供全方位的智能代码辅助功能。通过深度分析代码上下文，Nekoama 能够理解您的代码意图并提供精准的智能建议。</p>

        <h3>🚀 核心功能</h3>

        <h4>📝 智能命名建议</h4>
        <p>基于代码上下文和变量用途，为变量、方法、类提供符合最佳实践的命名建议，提升代码可读性和维护性。</p>

        <h4>📖 AI 驱动注释生成</h4>
        <p>自动生成符合项目规范的 KDoc/JavaDoc 注释，包括方法说明、参数描述、返回值说明和示例代码。</p>

        <h4>🛠️ 自定义代码生成</h4>
        <p>支持用户自定义提示词，可生成任何类型的代码内容，如算法实现、模板代码、重构建议等。</p>

        <h4>🔍 未使用代码分析</h4>
        <p>全面扫描项目，识别未使用的文件、类、方法和属性，帮助清理冗余代码，保持项目整洁。</p>

        <h3>📊 高级功能</h3>

        <h4>📈 Token 使用统计</h4>
        <p>实时监控 AI 服务的 Token 消耗量，支持按时间维度（今日/本周/本月）和使用类型分类统计，帮助优化 API 使用成本。</p>

        <h4>⚙️ 灵活配置</h4>
        <p>支持多种 AI 提供商配置，包括 OpenAI、Azure OpenAI 和自定义 API，可灵活调整模型参数、温度、超时等设置。</p>

        <h4>🎯 模块化工具窗口</h4>
        <p>现代化的工具窗口界面，支持标签页管理、状态持久化、动态扩展，提供丰富的使用统计和系统概览。</p>

        <h3>🛡️ 安全与性能</h3>

        <p><b>安全存储</b>：API 密钥通过 IntelliJ Password Safe 加密存储，确保数据安全。</p>
        <p><b>后台处理</b>：所有 AI 任务在后台线程执行，不阻塞 UI 操作，保持 IDE 流畅响应。</p>
        <p><b>错误处理</b>：完善的异常处理和用户友好的错误提示，确保插件稳定运行。</p>

        <p><b>支持语言</b>：Java、Kotlin（完全支持 K2 编译器模式）</p>
        <p><b>环境要求</b>：IntelliJ IDEA 2025.1+（since-build 251），JDK 21</p>
    ]]></description>

    <!-- 明确支持的 IntelliJ 平台版本范围，确保 K2 兼容性 -->
    <idea-version since-build="251" until-build="252.*"/>

    <!-- Resource bundle for i18n -->
    <resource-bundle>messages.NekoamaBundle</resource-bundle>

    <depends>com.intellij.modules.platform</depends>
    <!-- 依赖 Java 与 Kotlin 插件，确保 PSI 类可用且类加载顺序正确 -->
    <depends>com.intellij.java</depends>
    <!-- 明确支持 Kotlin K2 模式 -->
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- ToolWindow 注册 -->
        <toolWindow id="Nekoama"
                    anchor="right"
                    factoryClass="com.cw2.nekoama.presentation.toolwindow.NekoamaToolWindowFactory"
                    icon="/icons/NekoamaToolWindow.svg"/>

        <!-- 设置页面注册 -->
        <applicationConfigurable id="Nekoama.settings" displayName="Nekoama" instance="com.cw2.nekoama.presentation.settings.NekoamaConfigurable"/>

        <!-- 通知分组注册（使用稳定的分组ID，不随本地化变化） -->
        <notificationGroup id="Nekoama.Notifications" displayType="BALLOON" isLogByDefault="true"/>


        <!-- 启动时安装键入处理器（避免使用将移除的扩展点） -->
        <postStartupActivity implementation="com.cw2.nekoama.platform.lifecycle.NekoamaProjectActivity"/>

        <!-- 初始化指标系统 -->
        <projectActivity implementation="com.cw2.nekoama.platform.lifecycle.MetricsInitializer"/>

        <!-- Live Template 自定义宏注册：用于 AI 注释生成占位与替换 -->
        <liveTemplateMacro implementation="com.cw2.nekoama.presentation.templates.NekoamaAiCommentMacro"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <actions>
        <!-- 顶层 Nekoama 组（可用于扩展） -->
        <group id="Nekoama.Actions" text="Nekoama" popup="true">
            <action id="Nekoama.GenerateNaming" class="com.cw2.nekoama.presentation.actions.GenerateNamingAction" text="Name for Any" description="Generate naming suggestions" icon="AllIcons.Actions.GroupByModuleGroup"/>
            <action id="Nekoama.GenerateComment" class="com.cw2.nekoama.presentation.actions.GenerateCommentAction" text="Comment for Me" description="Generate documentation" icon="AllIcons.Actions.Lightning"/>
            <action id="Nekoama.CustomGenerate" class="com.cw2.nekoama.presentation.actions.CustomGenerateAction" text="IDEA of Neko" description="Custom generate with context" icon="AllIcons.Actions.EnableNewUi"/>
        </group>

        <!-- 未使用代码扫描 Action -->
        <action id="Nekoama.AnalyzeUnusedCode" class="com.cw2.nekoama.presentation.actions.AnalyzeUnusedCodeAction" text="Nekoama: Analyze Unused Code" description="Scan project for unused files/classes/methods" icon="AllIcons.Actions.ClearCash">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <!-- 右键菜单集成 -->
        <action id="Nekoama.CustomGenerate.Popup" class="com.cw2.nekoama.presentation.actions.CustomGenerateAction" text="IDEA of Neko" icon="AllIcons.Actions.EnableNewUi">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="Nekoama.GenerateNaming.Popup" class="com.cw2.nekoama.presentation.actions.GenerateNamingAction" text="Name for Any" icon="AllIcons.Actions.GroupByModuleGroup">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="Nekoama.GenerateComment.Popup" class="com.cw2.nekoama.presentation.actions.GenerateCommentAction" text="Comment for Me" icon="AllIcons.Actions.Lightning">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>