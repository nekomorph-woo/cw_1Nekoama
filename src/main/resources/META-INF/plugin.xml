<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>me.cw2.Nekoama</id>
    <name>Nekoama</name>
    <vendor url="https://github.com/cw2me">cw2</vendor>
    <description><![CDATA[
        <h2>Nekoama：AI 驱动的智能代码助手与代码质量分析工具</h2>

        <p><b>Nekoama</b>是一款专业的 IntelliJ IDEA 插件，融合大语言模型技术与深度代码分析能力，为开发者提供智能代码建议和代码质量洞察。通过 PSI API 深度理解代码结构，Nekoama 提供上下文感知的精准建议。</p>

        <h3>🎯 核心功能</h3>

        <h4>📝 智能命名建议（Name for Any）</h4>
        <p>基于代码语义上下文和变量用途，为变量、方法、类提供符合行业最佳实践的命名建议，提升代码可读性和团队协作效率。</p>

        <h4>📖 AI 驱动注释生成（Comment for Me）</h4>
        <p>自动生成符合项目规范的 KDoc/JavaDoc 注释，包含方法说明、参数描述、返回值说明和使用示例，支持中文和英文双语输出。</p>

        <h4>🧠 智能代码助手（IDEA for Neko）</h4>
        <p>支持自定义提示词的通用代码生成能力，可用于代码重构建议、算法实现、设计模式应用、单元测试生成等场景。</p>

        <h3>📋 支持范围</h3>

        <p><b>支持语言</b>：Java、Kotlin（完全支持 K2 编译器模式）</p>
        <p><b>IDE 版本</b>：IntelliJ IDEA 2025.1+（since-build 251）</p>
        <p><b>运行环境</b>：JDK 21</p>
    ]]></description>

    <!-- 明确支持的 IntelliJ 平台版本范围，确保 K2 兼容性 -->
    <idea-version since-build="251" until-build="252.*"/>

    <!-- Resource bundle for i18n -->
    <resource-bundle>messages.NekoamaBundle</resource-bundle>

    <depends>com.intellij.modules.platform</depends>
    <!-- 依赖 Java 与 Kotlin 插件，确保 PSI 类可用且类加载顺序正确 -->
    <depends>com.intellij.java</depends>
    <!-- 明确支持 Kotlin K2 模式 -->
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 设置页面注册 -->
        <applicationConfigurable id="Nekoama.settings" displayName="Nekoama"
                                 instance="com.cw2.nekoama.interfaces.intellij.settings.NekoamaConfigurable"/>

        <!-- 通知分组注册（使用稳定的分组ID，不随本地化变化） -->
        <notificationGroup id="Nekoama.Notifications" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <actions>
        <!-- 顶层 Nekoama 组（可用于扩展） -->
        <group id="Nekoama.Actions" text="Nekoama" popup="true">
            <action id="Nekoama.GenerateNaming" class="com.cw2.nekoama.interfaces.intellij.actions.GenerateNamingAction"
                    text="Name for Any" description="Generate naming suggestions"
                    icon="AllIcons.Actions.GroupByModuleGroup"/>
            <action id="Nekoama.GenerateComment" class="com.cw2.nekoama.interfaces.intellij.actions.GenerateCommentAction"
                    text="Comment for Me" description="Generate documentation" icon="AllIcons.Actions.Lightning"/>
            <action id="Nekoama.CustomGenerate" class="com.cw2.nekoama.interfaces.intellij.actions.CustomGenerateAction"
                    text="IDEA for Neko" description="Custom generate with context"
                    icon="AllIcons.Actions.EnableNewUi"/>
        </group>

        <!-- 右键菜单集成 -->
        <action id="Nekoama.CustomGenerate.Popup" class="com.cw2.nekoama.interfaces.intellij.actions.CustomGenerateAction"
                text="IDEA for Neko" icon="AllIcons.Actions.EnableNewUi">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="Nekoama.GenerateNaming.Popup" class="com.cw2.nekoama.interfaces.intellij.actions.GenerateNamingAction"
                text="Name for Any" icon="AllIcons.Actions.GroupByModuleGroup">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="Nekoama.GenerateComment.Popup" class="com.cw2.nekoama.interfaces.intellij.actions.GenerateCommentAction"
                text="Comment for Me" icon="AllIcons.Actions.Lightning">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>