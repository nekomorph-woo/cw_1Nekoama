<?xml version="1.0" encoding="UTF-8"?>
<templateSet group="Nekoama">
    <template name="nekoamac" value="/**\n * $DESC$\n */" description="Nekoama: comment block placeholder" toReformat="true" toShortenFQNames="true">
        <variable name="DESC" expression="nekoamaAiComment()" defaultValue="Nekoama: TODO 自动注释" alwaysStopAt="true"/>
        <context>
            <option name="JAVA_CODE" value="true"/>
            <option name="KOTLIN" value="true"/>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="nekoamatodo" value="// TODO($AUTHOR$ @ $DATE$): $WHAT$" description="Nekoama: TODO with author/date" toReformat="false" toShortenFQNames="false">
        <variable name="AUTHOR" expression="user()" defaultValue="" alwaysStopAt="false"/>
        <variable name="DATE" expression="date()" defaultValue="" alwaysStopAt="false"/>
        <variable name="WHAT" expression="complete()" defaultValue="Nekoama: 待办事项" alwaysStopAt="true"/>
        <context>
            <option name="JAVA_CODE" value="true"/>
            <option name="KOTLIN" value="true"/>
            <option name="OTHER" value="true"/>
        </context>
    </template>
</templateSet>
